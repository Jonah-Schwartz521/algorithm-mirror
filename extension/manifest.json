{
  "manifest_version": 3,
  "name": "Algorithm Mirror",
  "version": "0.0.7",
  "description": "Logs what your feed shows you.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://am.198-199-64-41.sslip.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "config.js",
        "db.js",
        "youtube.js",
        "core.js",
        "sync.js",
        "history.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.reddit.com/*"
      ],
      "js": [
        "config.js",
        "db.js",
        "reddit.js",
        "core.js",
        "sync.js",
        "history.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "config.js",
        "db.js",
        "x.js",
        "core.js",
        "sync.js",
        "history.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "config.js",
        "db.js",
        "instagram.js",
        "sync.js",
        "history.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Algorithm Mirror"
  }
}
