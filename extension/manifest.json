{
  "manifest_version": 3,
  "name": "Algorithm Mirror",
  "version": "0.0.1",
  "description": "Logs what your feed shows you.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["db.js", "content.js", "sync.js"],
      "run_at": "document_idle"
    }
  ]
}